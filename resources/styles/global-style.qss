/* ===========================================================================
   DE LA HOZ AUTOS SEMINUEVOS - GLOBAL APPLICATION STYLESHEET
   =========================================================================== */

/* 1. GLOBAL RESET & BASE TYPOGRAPHY
   --------------------------------------------------------------------------- */
QWidget {
    font-family: "Segoe UI", "Roboto", "Helvetica Neue", Arial, sans-serif;
    font-size: 12pt;
    font-weight: 400;
    color: #212529;               /* Primary Dark Charcoal */
    background-color: #FFFFFF;     /* Light Surface Canvas */
}

QFrame[class='right-content'] {
    background-color: #FFFFFF;
    border-right: none;
    border-bottom: 1px solid #212529;
    border-top: none;
    border-left: none;
}

QFrame[class='side-bar'] {
    border: 1px solid #212529;
}

QFrame[class='top-bar'] {
    border-bottom: 1px solid #212529;
    border-top: 1px solid #212529;
    border-left: none;
    border-right: 1px solid #212529;
}

QFrame[class='main-content'] {
    border-right: 1px solid #212529;
    border-top: none;
    border-left: none;
    border-bottom: none;
}

/* 2. TYPOGRAPHY HEADERS & LABELS
   --------------------------------------------------------------------------- */
/* H1 - Main Screen Header */
QLabel[class="h1"] {
    font-size: 20pt;
    font-weight: 700;
    color: #212529;
}

/* H2 - Section Header / Modal Title */
QLabel[class="h2"] {
    font-size: 15pt;
    font-weight: 700;
    color: #212529;
}

/* H3 - Subsection / Card Title */
QLabel[class="h3"] {
    font-size: 13pt;
    font-weight: 600;
    color: #495057;
}

/* Input Form Field Label */
QLabel[class="form-label"] {
    font-size: 9.5pt;
    font-weight: 600;
    color: #495057;
}

/* Financial & Numerical Highlights (Monospace fallback) */
QLabel[class="currency-display"] {
    font-family: "Consolas", "Monaco", "Segoe UI", sans-serif;
    font-size: 16pt;
    font-weight: 800;
    color: #0A25C9;               /* DE LA HOZ Royal Blue */
}

/* 3. INPUT CONTROLS & PLACEHOLDERS
   --------------------------------------------------------------------------- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTextEdit {
    font-size: 10pt;
    font-weight: 400;
    color: #212529;
    background-color: #FFFFFF;
    border: 1px solid #CED4DA;
    border-radius: 6px;
    padding: 6px 10px;
    min-height: 22px;
}

/* Input Focused State */
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDateEdit:focus, QTextEdit:focus {
    border: 1.5px solid #0A25C9;   /* DE LA HOZ Royal Blue */
    background-color: #FFFFFF;
}

/* Input Hover State */
QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDateEdit:hover {
    border-color: #ADB5BD;
}

/* Combo Box Dropdown Styling */
QComboBox::drop-down {
    border: none;
    width: 24px;
}

/* En cuanto se estiliza ::drop-down, Qt deja de dibujar la flecha nativa. Sin
   esta regla, TODOS los combos de la aplicación quedan sin indicador -- que es
   como estaban los del asistente hasta que US-03.1 trajo este ícono y lo
   aplicó solo a la barra de filtros. Va global por eso. */
QComboBox::down-arrow {
    image: url(:/icons/chevron_down.png);
    width: 12px;
    height: 12px;
}

/* 4. ERROR & VALIDATION STATES
   --------------------------------------------------------------------------- */
/* Applied dynamically when field validation fails */
QLineEdit[hasError="true"], QComboBox[hasError="true"], QDateEdit[hasError="true"] {
    border: 1.5px solid #D90429;   /* DE LA HOZ Crimson Red */
    background-color: #FFF5F5;
}

/* Helper Error Text Label */
QLabel[class="error-text"] {
    font-size: 8.5pt;
    font-weight: 600;
    color: #D90429;               /* DE LA HOZ Crimson Red */
}

/* 5. BUTTONS & ACTIONS
   --------------------------------------------------------------------------- */
/* Side Menu Bar Button */
QPushButton[class="menu-bar"] {
    background-color: #F4F6F9;
    border: none;
    color: #495057;
    font-size: 13pt;
    font-weight: 600;
    padding: 12px 16px;
    text-align: center;
}

QPushButton[class="menu-bar"]:hover {
    background-color: rgba(10, 37, 201, 0.10);
    color: #0A25C9;
}

QPushButton[class="menu-bar"]:checked {
    background-color: #c3cbdb;
    color: #0A25C9;
    font-weight: 700;
    /* The thick blue accent bar on the left edge */
    border-left: 4px solid #0A25C9;
    border-top: none;
    border-bottom: none;
    border-right: none;
}

/* Primary Brand Action Button */
QPushButton[class="primary"] {
    background-color: #0A25C9;   /* DE LA HOZ Royal Blue */
    border: none;
    color: #FFFFFF;
    font-size: 12pt;
    font-weight: 600;
    border-radius: 6px;
    padding: 8px 18px;
}

QPushButton[class="primary"]:hover {
    background-color: #081CA2;
}

QPushButton[class="primary"]:pressed {
    background-color: #06157B;
}

/* Secondary Button (Detalles, Cancelar) */
QPushButton[class="secondary"] {
    background-color: #FFFFFF;
    color: #495057;
    font-size: 10pt;
    font-weight: 600;
    border: 1px solid #6C757D;    /* Metallic Slate Grey */
    border-radius: 6px;
    padding: 7px 16px;
}

QPushButton[class="secondary"]:hover {
    background-color: #0A25C9;
    color: #FFFFFF;
    border-color: #0A25C9;
}

/* Danger / Delete Action Button */
QPushButton[class="danger"] {
    background-color: #D90429;   /* DE LA HOZ Crimson Red */
    color: #FFFFFF;
    font-size: 10pt;
    font-weight: 700;
    border: none;
    border-radius: 6px;
    padding: 8px 18px;
}

QPushButton[class="danger"]:hover {
    background-color: #B80322;
}

/* 6. STATUS BADGES & PILLS
   --------------------------------------------------------------------------- */
QLabel[status="available"] {
    background-color: #D1E7DD;
    color: #0F5132;
    font-size: 8.5pt;
    font-weight: 700;
    border-radius: 4px;
    padding: 3px 8px;
}

QLabel[status="reserved"] {
    background-color: #FFE6E6;
    color: #D90429;
    border: 1px solid #FFB3B3;
    font-size: 8.5pt;
    font-weight: 700;
    border-radius: 4px;
    padding: 3px 8px;
}

/* 7. CARDS & CONTAINERS
   --------------------------------------------------------------------------- */
QFrame#cardPanel, QWidget#cardPanel {
    background-color: #FFFFFF;
    border: 1px solid #DEE2E6;
    border-radius: 10px;
}

/* 8. VEHICLE WIZARD (US-03.2)
   --------------------------------------------------------------------------- */
/* Stepper (Detalles / Condición / Archivos). stepState is a dynamic property
   set at runtime by WizardStepper: "pending" | "current" | "done". */
QPushButton[class="wizard-step"] {
    background-color: transparent;
    border: none;
    border-bottom: 3px solid transparent;
    /* El padding real lo da innerLayout->setContentsMargins() en
       WizardStepper (el botón usa un layout hijo con QLabels en vez de
       QPushButton::setText/setIcon, así que su sizeHint ignora el
       "padding" de QSS -- ver StepButton::sizeHint). */
}

QPushButton[class="wizard-step"][stepState="current"] {
    border-bottom: 3px solid #0A25C9;
}

/* Texto del paso -- separado del QPushButton (que ahora solo pinta fondo/
   subrayado) para poder controlar el espacio contra el ícono de la
   palomita y su alineación vertical desde WizardStepper. */
QLabel[class="wizard-step-text"] {
    background-color: transparent;
    color: #6C757D;
    font-size: 13pt;
    font-weight: 600;
}

QLabel[class="wizard-step-text"][stepState="current"],
QLabel[class="wizard-step-text"][stepState="done"] {
    /* El verde va solo en el ícono de la palomita (check-badge-green.png),
       no en el texto. */
    color: #212529;
}

/* Small flat icon buttons (galería de fotos: quitar / marcar portada). */
QPushButton[class="icon-flat"] {
    background-color: transparent;
    border: none;
    padding: 4px;
}

QPushButton[class="icon-flat"]:hover {
    background-color: rgba(10, 37, 201, 0.08);
    border-radius: 4px;
}

/* Fila del checklist de condición: se atenúa cuando el ítem no está marcado. */
QWidget[class="condition-row"][itemChecked="false"] QLabel,
QWidget[class="condition-row"][itemChecked="false"] QRadioButton {
    color: #ADB5BD;
}

/* Checkbox ("¿tiene luces delanteras?") y radio buttons circulares (Estado
   óptimo / Con fallas) del checklist de condición. IMPORTANTE: en cuanto
   una regla QSS toca ::indicator, Qt deja de pintar el indicador nativo del
   sistema operativo (aunque sea solo width/height) -- hay que dar border y
   fondo explícitos o el control queda invisible. Checked se distingue por
   palomita/punto azul sobre fondo blanco, no por relleno sólido. */
QCheckBox, QRadioButton {
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1.5px solid #ADB5BD;
    background-color: #FFFFFF;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #0A25C9;
}

QCheckBox::indicator {
    border-radius: 4px;
}

QCheckBox::indicator:checked {
    background-color: #FFFFFF;
    border-color: #0A25C9;
    image: url(:/icons/checkmark.png);
}

QRadioButton::indicator {
    border-radius: 7px;
}

QRadioButton::indicator:checked {
    border-color: #0A25C9;
    background-color: qradialgradient(
        cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5,
        stop:0 #0A25C9, stop:0.45 #0A25C9, stop:0.55 #FFFFFF, stop:1 #FFFFFF);
}

QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    border-color: #DEE2E6;
    background-color: #F4F6F9;
}
/* =====================================================================
   Inventario QCSS Estilos
   ===================================================================== */

/* ======== CONTENEDOR DE LA BARRA ======== */
QFrame[class="navBar"] {
    background-color: #c3cbdb;
    border-bottom: 1px solid #212529;
    align-items: stretch;
}

/* ======== BOTONES DE NAVEGACIÓN DEL NAVBAR ======== */
QPushButton[class="navButton"] {
	background-color: transparent;
    color: #46527a;
    border: none;
    margin: 0px;
    padding: 10px 28px;
    font-size: 12pt;
    font-weight: 600;
}

/* Hover */
QPushButton[class="navButton"]:hover {
    background-color: rgba(255, 255, 255, 0.25);
	border-top-right-radius: 10px;
	border-top-left-radius: 10px;
}

/* Activo (checked) */
QPushButton[class="navButton"]:checked {
    background-color: #081ca2;
    color: #ffffff;
    border-top-right-radius: 10px;
	border-top-left-radius: 10px;
}

/* Presionado momentáneo */
QPushButton[class="navButton"]:pressed {
   border-top-right-radius: 10px;
	border-top-left-radius: 10px;
    background-color: #0056b3;
    color: #FFFFFF;
}


/* ======== BARRA DE FILTROS (Estado, Fecha inicio, Agregar Vehiculo) ======== */
#filterBar {
    background-color: transparent;
    padding: 0px -10px 0px 0px;
	border-right: none;
    border-bottom: 1px solid #212529;
    border-top: none;
    border-left: none;
	padding-bottom: 5px;
}

#filterBar QLabel {
    font-size: 14px;
    font-weight: 600;
    color: #2c3856;
}

QComboBox[class="filterCombo"] {
    background-color: #ffffff;
    border: 1px solid #c2c9d6;
    border-radius: 8px;
    padding: 8px 12px;
    min-width: 120px;
    font-size: 14px;
    color: #2c3856;
}

QComboBox[class="filterCombo"]:hover {
    border: 1px solid #2f6fed;
}

QComboBox[class="filterCombo"]::drop-down {
    border: none;
    width: 24px;
}

/* La flecha ya la pone la regla global de QComboBox::down-arrow (sección 3);
   aquí no hace falta repetirla. */

/* Cada opción de la lista */
/* ATENCIÓN: de aquí en adelante y hasta el final del bloque de calendario, las
   reglas NO llevan filtro de clase, así que son GLOBALES pese a estar bajo el
   rótulo de Inventario. Aplican también a los doce combos y al calendario del
   asistente de registro. Es deliberado -- dos estilos de popup para el mismo
   control se ve peor que uno solo --, pero conviene saberlo antes de tocarlas
   creyendo que solo afectan a esta pantalla. */
QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    border-radius: 6px;
    color: #2c3856;
    min-height: 26px;
}

/* Hover al pasar el mouse sobre una opción */
QComboBox QAbstractItemView::item:hover {
    background-color: #c3cbdb;
    color: #46527a;
}

/* Opción seleccionada (con o sin mouse encima) */
QComboBox QAbstractItemView::item:selected {
    background-color: #081ca2;
    color: #ffffff;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #c2c9d6;
    outline: none;
    padding: 4px;
}

/* ---------- QDateEdit (mismo look que QComboBox, sin botón cuadrado) ---------- */
QDateEdit[class="dateFilter"] {
    background-color: #ffffff;
    border: 1px solid #c2c9d6;
    border-radius: 8px;
    padding: 8px 12px;
    min-width: 120px;
    font-size: 14px;
    color: #2c3856;
}

QDateEdit[class="dateFilter"]:hover {
    border: 1px solid #2f6fed;
}

/* Elimina el relieve/recuadro del botón de flecha */
QDateEdit[class="dateFilter"]::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 24px;
    border: none;         /* sin borde propio */
    background: transparent;  /* sin fondo/recuadro que sobresalga */
}

/* Mismo ícono que usa el QComboBox */
QDateEdit[class="dateFilter"]::down-arrow {
    image: url(:/icons/chevron_down.png);
    width: 12px;
    height: 12px;
}


/* Quita el botón nativo de subir/bajar (spin buttons) que Qt agrega por defecto */
QDateEdit[class="dateFilter"]::up-button,
QDateEdit[class="dateFilter"]::down-button {
    width: 0px;
    border: none;
    background: transparent;
}

/* Popup del calendario */
QCalendarWidget QWidget {
    background-color: #ffffff;
    color: #2c3856;
}

QCalendarWidget QAbstractItemView:enabled {
    selection-background-color: #081ca2;
    selection-color: #ffffff;
    outline: none;
}

QCalendarWidget QAbstractItemView::item:selected {
    background-color: #081ca2;
    color: #ffffff;
    border-radius: 6px;
}

/* 10. SCROLLBARS (globales)
   ---------------------------------------------------------------------------
   Tampoco llevan filtro: aplican a las dos áreas desplazables del asistente
   (checklist de condición y galería de fotos), a los popups de los combos y al
   login, no solo a la lista del inventario. */
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    /* US-03.1 estilizó handle y flechas pero no el canal; sin esto, en algunos
       temas de Windows se alcanza a ver el surco nativo detrás. */
    background: transparent;
}
/* ---------- QListWidget contenedor de las tarjetas ---------- */

/* Scrollbar del QListWidget */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #a9b3c7;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #a9b3c7;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}
