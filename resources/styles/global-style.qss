/* ===========================================================================
   DE LA HOZ AUTOS SEMINUEVOS - GLOBAL APPLICATION STYLESHEET
   =========================================================================== */

/* 1. GLOBAL RESET & BASE TYPOGRAPHY
   --------------------------------------------------------------------------- */
QWidget {
    font-family: "Segoe UI", "Roboto", "Helvetica Neue", Arial, sans-serif;
    font-size: 12pt;
    font-weight: 400;
    color: #212529;               /* Primary Dark Charcoal */
    background-color: #FFFFFF;     /* Light Surface Canvas */
}

QFrame[class='right-content'] {
    background-color: #FFFFFF;
    border-right: none;
    border-bottom: 1px solid #212529;
    border-top: none;
    border-left: none;
}

QFrame[class='side-bar'] {
    border: 1px solid #212529;
}

QFrame[class='top-bar'] {
    border-bottom: 1px solid #212529;
    border-top: 1px solid #212529;
    border-left: none;
    border-right: 1px solid #212529;
}

QFrame[class='main-content'] {
    border-right: 1px solid #212529;
    border-top: none;
    border-left: none;
    border-bottom: none;
}

/* 2. TYPOGRAPHY HEADERS & LABELS
   --------------------------------------------------------------------------- */
/* H1 - Main Screen Header */
QLabel[class="h1"] {
    font-size: 20pt;
    font-weight: 700;
    color: #212529;
}

/* H2 - Section Header / Modal Title */
QLabel[class="h2"] {
    font-size: 15pt;
    font-weight: 700;
    color: #212529;
}

/* H3 - Subsection / Card Title */
QLabel[class="h3"] {
    font-size: 13pt;
    font-weight: 600;
    color: #495057;
}

/* Input Form Field Label */
QLabel[class="form-label"] {
    font-size: 9.5pt;
    font-weight: 600;
    color: #495057;
}

/* Financial & Numerical Highlights (Monospace fallback) */
QLabel[class="currency-display"] {
    font-family: "Consolas", "Monaco", "Segoe UI", sans-serif;
    font-size: 16pt;
    font-weight: 800;
    color: #0A25C9;               /* DE LA HOZ Royal Blue */
}

/* 3. INPUT CONTROLS & PLACEHOLDERS
   --------------------------------------------------------------------------- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTextEdit {
    font-size: 10pt;
    font-weight: 400;
    color: #212529;
    background-color: #FFFFFF;
    border: 1px solid #CED4DA;
    border-radius: 6px;
    padding: 6px 10px;
    min-height: 22px;
}

/* Input Focused State */
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDateEdit:focus, QTextEdit:focus {
    border: 1.5px solid #0A25C9;   /* DE LA HOZ Royal Blue */
    background-color: #FFFFFF;
}

/* Input Hover State */
QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDateEdit:hover {
    border-color: #ADB5BD;
}

/* Combo Box Dropdown Styling */
QComboBox::drop-down {
    border: none;
    width: 24px;
}

/* 4. ERROR & VALIDATION STATES
   --------------------------------------------------------------------------- */
/* Applied dynamically when field validation fails */
QLineEdit[hasError="true"], QComboBox[hasError="true"], QDateEdit[hasError="true"] {
    border: 1.5px solid #D90429;   /* DE LA HOZ Crimson Red */
    background-color: #FFF5F5;
}

/* Helper Error Text Label */
QLabel[class="error-text"] {
    font-size: 8.5pt;
    font-weight: 600;
    color: #D90429;               /* DE LA HOZ Crimson Red */
}

/* 5. BUTTONS & ACTIONS
   --------------------------------------------------------------------------- */
/* Side Menu Bar Button */
QPushButton[class="menu-bar"] {
    background-color: #F4F6F9;
    border: none;
    color: #495057;
    font-size: 13pt;
    font-weight: 600;
    padding: 12px 16px;
    text-align: center;
}

QPushButton[class="menu-bar"]:hover {
    background-color: rgba(10, 37, 201, 0.10);
    color: #0A25C9;
}

QPushButton[class="menu-bar"]:checked {
    background-color: rgba(10, 37, 201, 0.10);
    color: #0A25C9;
    font-weight: 700;
    /* The thick blue accent bar on the left edge */
    border-left: 4px solid #0A25C9;
    border-top: none;
    border-bottom: none;
    border-right: none;
}

/* Primary Brand Action Button */
QPushButton[class="primary"] {
    background-color: #0A25C9;   /* DE LA HOZ Royal Blue */
    border: none;
    color: #FFFFFF;
    font-size: 12pt;
    font-weight: 600;
    border-radius: 6px;
    padding: 8px 18px;
}

QPushButton[class="primary"]:hover {
    background-color: #081CA2;
}

QPushButton[class="primary"]:pressed {
    background-color: #06157B;
}

/* Secondary Button (Detalles, Cancelar) */
QPushButton[class="secondary"] {
    background-color: #FFFFFF;
    color: #495057;
    font-size: 10pt;
    font-weight: 600;
    border: 1px solid #6C757D;    /* Metallic Slate Grey */
    border-radius: 6px;
    padding: 7px 16px;
}

QPushButton[class="secondary"]:hover {
    background-color: #0A25C9;
    color: #FFFFFF;
    border-color: #0A25C9;
}

/* Danger / Delete Action Button */
QPushButton[class="danger"] {
    background-color: #D90429;   /* DE LA HOZ Crimson Red */
    color: #FFFFFF;
    font-size: 10pt;
    font-weight: 700;
    border: none;
    border-radius: 6px;
    padding: 8px 18px;
}

QPushButton[class="danger"]:hover {
    background-color: #B80322;
}

/* 6. STATUS BADGES & PILLS
   --------------------------------------------------------------------------- */
QLabel[status="available"] {
    background-color: #D1E7DD;
    color: #0F5132;
    font-size: 8.5pt;
    font-weight: 700;
    border-radius: 4px;
    padding: 3px 8px;
}

QLabel[status="reserved"] {
    background-color: #FFE6E6;
    color: #D90429;
    border: 1px solid #FFB3B3;
    font-size: 8.5pt;
    font-weight: 700;
    border-radius: 4px;
    padding: 3px 8px;
}

/* 7. CARDS & CONTAINERS
   --------------------------------------------------------------------------- */
QFrame#cardPanel, QWidget#cardPanel {
    background-color: #FFFFFF;
    border: 1px solid #DEE2E6;
    border-radius: 10px;
}

/* 8. VEHICLE WIZARD (US-03.2)
   --------------------------------------------------------------------------- */
/* Stepper (Detalles / Condición / Archivos). stepState is a dynamic property
   set at runtime by WizardStepper: "pending" | "current" | "done". */
QPushButton[class="wizard-step"] {
    background-color: transparent;
    border: none;
    border-bottom: 3px solid transparent;
    /* El padding real lo da innerLayout->setContentsMargins() en
       WizardStepper (el botón usa un layout hijo con QLabels en vez de
       QPushButton::setText/setIcon, así que su sizeHint ignora el
       "padding" de QSS -- ver StepButton::sizeHint). */
}

QPushButton[class="wizard-step"][stepState="current"] {
    border-bottom: 3px solid #0A25C9;
}

/* Texto del paso -- separado del QPushButton (que ahora solo pinta fondo/
   subrayado) para poder controlar el espacio contra el ícono de la
   palomita y su alineación vertical desde WizardStepper. */
QLabel[class="wizard-step-text"] {
    background-color: transparent;
    color: #6C757D;
    font-size: 13pt;
    font-weight: 600;
}

QLabel[class="wizard-step-text"][stepState="current"],
QLabel[class="wizard-step-text"][stepState="done"] {
    /* El verde va solo en el ícono de la palomita (check-badge-green.png),
       no en el texto. */
    color: #212529;
}

/* Small flat icon buttons (galería de fotos: quitar / marcar portada). */
QPushButton[class="icon-flat"] {
    background-color: transparent;
    border: none;
    padding: 4px;
}

QPushButton[class="icon-flat"]:hover {
    background-color: rgba(10, 37, 201, 0.08);
    border-radius: 4px;
}

/* Fila del checklist de condición: se atenúa cuando el ítem no está marcado. */
QWidget[class="condition-row"][itemChecked="false"] QLabel,
QWidget[class="condition-row"][itemChecked="false"] QRadioButton {
    color: #ADB5BD;
}

/* Checkbox ("¿tiene luces delanteras?") y radio buttons circulares (Estado
   óptimo / Con fallas) del checklist de condición. IMPORTANTE: en cuanto
   una regla QSS toca ::indicator, Qt deja de pintar el indicador nativo del
   sistema operativo (aunque sea solo width/height) -- hay que dar border y
   fondo explícitos o el control queda invisible. Checked se distingue por
   palomita/punto azul sobre fondo blanco, no por relleno sólido. */
QCheckBox, QRadioButton {
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1.5px solid #ADB5BD;
    background-color: #FFFFFF;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #0A25C9;
}

QCheckBox::indicator {
    border-radius: 4px;
}

QCheckBox::indicator:checked {
    background-color: #FFFFFF;
    border-color: #0A25C9;
    image: url(:/icons/checkmark.png);
}

QRadioButton::indicator {
    border-radius: 7px;
}

QRadioButton::indicator:checked {
    border-color: #0A25C9;
    background-color: qradialgradient(
        cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5,
        stop:0 #0A25C9, stop:0.45 #0A25C9, stop:0.55 #FFFFFF, stop:1 #FFFFFF);
}

QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    border-color: #DEE2E6;
    background-color: #F4F6F9;
}
