/* ===========================================================================
   DE LA HOZ AUTOS SEMINUEVOS - GLOBAL APPLICATION STYLESHEET
   =========================================================================== */

/* 1. GLOBAL RESET & BASE TYPOGRAPHY
   --------------------------------------------------------------------------- */
QWidget {
    /*font-family: "Segoe UI", "Roboto", "Helvetica Neue", Arial, sans-serif;*/
    font-size: 20pt;
    font-weight: 400;
    color: #212529;               /* Primary Dark Charcoal */
    background-color: #FFFFFF;     /* Light Surface Canvas */
}

QComboBox {
    combobox-popup: 0;
}

/* Chrome de la ventana principal.
   Antes cada zona iba encajonada con `1px solid #212529`: hairlines negras
   que dibujaban la retícula de la ventana y son lo que hacía ver la pantalla
   "de sistema operativo" en vez de de producto. El separador ahora es un gris
   claro (#E6E8EC) y solo donde de verdad separa: a la derecha de la barra
   lateral y debajo de la barra superior. El resto de los marcos no pinta
   nada, que es lo que deja respirar al blanco. */
QFrame[class='right-content'],
QFrame[class='main-content'] {
    background-color: #FFFFFF;
    border: none;
}

QFrame[class='side-bar'] {
    background-color: #FFFFFF;
    border: none;
    border-right: 1px solid #E6E8EC;
}

QFrame[class='top-bar'] {
    background-color: #FFFFFF;
    border: none;
    border-bottom: 1px solid #E6E8EC;
}

/* Rol de la persona conectada, al lado del avatar. Mismo peso y mismo negro
   que el título de las tarjetas y el de la pestaña activa: es una afirmación
   sobre quién está usando la aplicación, no un rótulo secundario, y en gris
   claro se leía como texto deshabilitado. */
QLabel#userRoleLabel {
    background: transparent;
    font-size: 11pt;
    font-weight: 600;
    color: #111827;
}

/* El avatar solo sostiene el pixmap: sin fondo propio, o el blanco de la regla
   base de QWidget asomaría en las esquinas del círculo. */
QLabel#avatarLabel {
    background: transparent;
    border: none;
}

/* 2. TYPOGRAPHY HEADERS & LABELS
   --------------------------------------------------------------------------- */
/* H1 - Main Screen Header */
QLabel[class="h1"] {
    font-size: 20pt;
    font-weight: 700;
    color: #212529;
}

/* H2 - Section Header / Modal Title */
QLabel[class="h2"] {
    font-size: 15pt;
    font-weight: 700;
    color: #212529;
}

/* H3 - Subsection / Card Title */
QLabel[class="h3"] {
    font-size: 13pt;
    font-weight: 600;
    color: #495057;
}

/* Input Form Field Label */
QLabel[class="form-label"] {
    font-size: 9.5pt;
    font-weight: 600;
    color: #495057;
}

/* Financial & Numerical Highlights (Monospace fallback) */
QLabel[class="currency-display"] {
    font-family: "Consolas", "Monaco", "Segoe UI", sans-serif;
    font-size: 16pt;
    font-weight: 800;
    color: #0A25C9;               /* DE LA HOZ Royal Blue */
}

/* 3. INPUT CONTROLS & PLACEHOLDERS
   --------------------------------------------------------------------------- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTextEdit {
    font-size: 10pt;
    font-weight: 400;
    color: #212529;
    background-color: #FFFFFF;
    border: 1px solid #CED4DA;
    border-radius: 6px;
    padding: 6px 10px;
    min-height: 22px;
}

/* Input Focused State */
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDateEdit:focus, QTextEdit:focus {
    /*border: 1.5px solid #0A25C9;
    background-color: #FFFFFF;*/
    border: 2px solid #0A25C9;
}

/* Input Hover State */
QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDateEdit:hover {
    border: 1px solid #ADB5BD;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    image: url(:/icons/chevron_down.png);
    width: 12px;
    height: 12px;
}

QComboBox::down-arrow:on {
    image: url(:/icons/chevron_up.png);
}

QComboBox:disabled {
    background-color: #F8F9FA;
    border-color: #E9ECEF;
    color: #ADB5BD;
}


/* 4. ERROR & VALIDATION STATES
   --------------------------------------------------------------------------- */
/* Applied dynamically when field validation fails */
QLineEdit[hasError="true"], QComboBox[hasError="true"], QDateEdit[hasError="true"] {
    border: 1.5px solid #D90429;   /* DE LA HOZ Crimson Red */
    background-color: #FFF5F5;
}

/* Helper Error Text Label */
QLabel[class="error-text"] {
    font-size: 8.5pt;
    font-weight: 600;
    color: #D90429;               /* DE LA HOZ Crimson Red */
}

/* 5. BUTTONS & ACTIONS
   --------------------------------------------------------------------------- */
/* Renglón del menú lateral -- la pastilla que dibuja SidebarMenuItem.
   Aquí solo va el FONDO. El tamaño no sale de este `padding` (sizeHint()
   viene del layout interno del componente, ver SidebarMenuItem::sizeHint) y
   el color del texto tampoco sale de este `color`, porque el título es un
   QLabel hijo y no el text() del botón. El margen lateral es lo que separa la
   pastilla del borde de la barra.

   Sin la barra azul de 4px del borde izquierdo que tenía antes: con el fondo
   gris marcando el módulo activo, el acento era una segunda señal para lo
   mismo, y además desalineaba el texto del renglón activo contra los otros
   tres. */
QPushButton[class="menu-bar"] {
    background-color: transparent;
    border: none;
    border-radius: 14px;
    margin: 0px 10px;
}

QPushButton[class="menu-bar"]:hover {
    background-color: #F2F4F8;
}

QPushButton[class="menu-bar"]:checked {
    background-color: #E8EAED;
}

/* Título del renglón. El color va por la propiedad dinámica itemState y NO
   por un selector de descendiente con pseudo-estado del tipo
   `QPushButton[class="menu-bar"]:checked QLabel`: Qt no aplica de forma
   fiable el pseudo-estado de un ancestro sobre sus descendientes. Quien fija
   itemState y re-poliza es SidebarMenuItem::refreshState(); es el mismo
   arreglo que WizardStepper hace con stepState. */
QLabel[class="menu-bar-title"] {
    background: transparent;
    font-size: 12pt;
    font-weight: 600;
    color: #4B5563;
}

QLabel[class="menu-bar-title"][itemState="hover"] {
    color: #0A25C9;
}

QLabel[class="menu-bar-title"][itemState="selected"] {
    color: #111827;
    font-weight: 700;
}

/* La caja del ícono no pinta nada propia: solo sostiene el pixmap. Hace falta
   apagarle el fondo explícitamente porque la regla base de QWidget (sección
   1) le pone blanco, y sobre la pastilla gris se vería un recuadro. */
QLabel[class="menu-bar-icon"] {
    background: transparent;
    border: none;
}

/* Primary Brand Action Button */
QPushButton[class="primary"] {
    background-color: #0A25C9;   /* DE LA HOZ Royal Blue */
    border: none;
    color: #FFFFFF;
    font-size: 12pt;
    font-weight: 600;
    border-radius: 6px;
    padding: 8px 18px;
}

QPushButton[class="primary"]:hover {
    background-color: #081CA2;
}

QPushButton[class="primary"]:pressed {
    background-color: #06157B;
}

/* Secondary Button (Detalles, Cancelar) */
QPushButton[class="secondary"] {
    background-color: #FFFFFF;
    color: #495057;
    font-size: 10pt;
    font-weight: 600;
    border: 1px solid #6C757D;    /* Metallic Slate Grey */
    border-radius: 6px;
    padding: 7px 16px;
}

QPushButton[class="secondary"]:hover {
    background-color: #0A25C9;
    color: #FFFFFF;
    border-color: #0A25C9;
}

/* Danger / Delete Action Button */
QPushButton[class="danger"] {
    background-color: #D90429;   /* DE LA HOZ Crimson Red */
    color: #FFFFFF;
    font-size: 10pt;
    font-weight: 700;
    border: none;
    border-radius: 6px;
    padding: 8px 18px;
}

QPushButton[class="danger"]:hover {
    background-color: #B80322;
}

/* 6. STATUS BADGES & PILLS
   --------------------------------------------------------------------------- */
QLabel[status="available"] {
    background-color: #D1E7DD;
    color: #0F5132;
    font-size: 8.5pt;
    font-weight: 700;
    border-radius: 4px;
    padding: 3px 8px;
}

QLabel[status="reserved"] {
    background-color: #FFE6E6;
    color: #D90429;
    border: 1px solid #FFB3B3;
    font-size: 8.5pt;
    font-weight: 700;
    border-radius: 4px;
    padding: 3px 8px;
}

/* 7. CARDS & CONTAINERS
   --------------------------------------------------------------------------- */
QFrame#cardPanel, QWidget#cardPanel {
    background-color: #FFFFFF;
    border: 1px solid #DEE2E6;
    border-radius: 10px;
}

/* 8. VEHICLE WIZARD (US-03.2)
   --------------------------------------------------------------------------- */
/* Stepper (Detalles / Condición / Archivos). stepState is a dynamic property
   set at runtime by WizardStepper: "pending" | "current" | "done". */
QPushButton[class="wizard-step"] {
    background-color: transparent;
    border: none;
    border-bottom: 3px solid transparent;
    /* El padding real lo da innerLayout->setContentsMargins() en
       WizardStepper (el botón usa un layout hijo con QLabels en vez de
       QPushButton::setText/setIcon, así que su sizeHint ignora el
       "padding" de QSS -- ver StepButton::sizeHint). */
}

QPushButton[class="wizard-step"][stepState="current"] {
    border-bottom: 3px solid #0A25C9;
}

/* Texto del paso -- separado del QPushButton (que ahora solo pinta fondo/
   subrayado) para poder controlar el espacio contra el ícono de la
   palomita y su alineación vertical desde WizardStepper. */
QLabel[class="wizard-step-text"] {
    background-color: transparent;
    color: #6C757D;
    font-size: 13pt;
    font-weight: 600;
}

QLabel[class="wizard-step-text"][stepState="current"],
QLabel[class="wizard-step-text"][stepState="done"] {
    /* El verde va solo en el ícono de la palomita (check-badge-green.png),
       no en el texto. */
    color: #212529;
}

/* Small flat icon buttons (galería de fotos: quitar / marcar portada). */
QPushButton[class="icon-flat"] {
    background-color: transparent;
    border: none;
    padding: 4px;
}

QPushButton[class="icon-flat"]:hover {
    background-color: rgba(10, 37, 201, 0.08);
    border-radius: 4px;
}

/* Fila del checklist de condición: se atenúa cuando el ítem no está marcado. */
QWidget[class="condition-row"][itemChecked="false"] QLabel,
QWidget[class="condition-row"][itemChecked="false"] QRadioButton {
    color: #ADB5BD;
}

/* Checkbox ("¿tiene luces delanteras?") y radio buttons circulares (Estado
   óptimo / Con fallas) del checklist de condición. IMPORTANTE: en cuanto
   una regla QSS toca ::indicator, Qt deja de pintar el indicador nativo del
   sistema operativo (aunque sea solo width/height) -- hay que dar border y
   fondo explícitos o el control queda invisible. Checked se distingue por
   palomita/punto azul sobre fondo blanco, no por relleno sólido. */
QCheckBox, QRadioButton {
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1.5px solid #ADB5BD;
    background-color: #FFFFFF;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #0A25C9;
}

QCheckBox::indicator {
    border-radius: 4px;
}

QCheckBox::indicator:checked {
    background-color: #FFFFFF;
    border-color: #0A25C9;
    image: url(:/icons/checkmark.png);
}

QRadioButton::indicator {
    border-radius: 7px;
}

QRadioButton::indicator:checked {
    border-color: #0A25C9;
    background-color: qradialgradient(
        cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5,
        stop:0 #0A25C9, stop:0.45 #0A25C9, stop:0.55 #FFFFFF, stop:1 #FFFFFF);
}

QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    border-color: #DEE2E6;
    background-color: #F4F6F9;
}
/* =====================================================================
   Inventario QCSS Estilos
   ===================================================================== */

/* Fondo de la columna de inventario: un gris muy claro que arranca en la fila
   de pestañas y llega al fondo de la ventana. Es lo que convierte las tarjetas
   en superficies que flotan sobre la página; sobre blanco, su borde gris claro
   era lo único que las separaba del fondo y se leían como una lista plana.

   OJO: inventoryPage es un QWidget pelado, no un QFrame, y Qt NO pinta el
   background de QSS en un QWidget a menos que lleve WA_StyledBackground. Ese
   atributo lo activa MainWindow; sin él esta regla no hace nada y el gris no
   aparece. */
QWidget#inventoryPage {
    background-color: #F4F5F7;
}

/* ======== CONTENEDOR DE LA FILA DE PESTAÑAS ========
   Se selecciona por objectName (#navBar) y NO por [class="navBar"]. El
   selector de clase no estaba casando aquí: la fila se quedaba blanca, con el
   fondo que le da la regla base de QWidget, y antes tampoco había llegado a
   pintar su border-bottom.

   La diferencia entre los dos selectores está en cómo los genera uic: el
   objectName se asigna en setupUi() directamente, mientras que la propiedad
   `class` se asigna al final, dentro de retranslateUi(), y pasando por
   QCoreApplication::translate(). El objectName no depende de nada de eso.

   Mismo gris que inventoryPage, y no `transparent`: así no depende tampoco de
   que la transparencia se propague desde el padre. Si cambia el gris de la
   página, hay que cambiarlo aquí también. */
QFrame#navBar {
    background-color: #F4F5F7;
    border: none;
}

/* La línea divisoria bajo las pestañas. Es un widget propio (ver navDivider en
   mainwindow.ui) y no el border-bottom del contenedor: como borde de QSS no
   llegaba a dibujarse en la aplicación, aunque la misma regla sí pintara en un
   banco de pruebas aislado. Un fondo sobre un QFrame se pinta siempre.

   Va más claro (#F0F2F5) que los divisores de la barra lateral y la superior
   (#E6E8EC), a diferencia de lo que suponía antes: recorre TODA la pantalla de
   orilla a orilla y es la línea más larga de la ventana, así que al mismo tono
   pesaba más que ninguna. Bajarle el contraste es lo que la hace leerse como
   más fina sin poder adelgazarla: 1 px ya es el mínimo de un widget. */
QFrame#navDivider {
    background-color: #F0F2F5;
    border: none;
}

/* ======== PESTAÑAS Adquisición / Consignación (NavTabItem) ========
   Pestañas de texto subrayado, no botones rellenos. El azul sólido que tenían
   antes le daba a la pestaña activa más peso visual que a "Agregar Vehículo",
   y elegir entre dos vistas no es una acción: no debería ser lo más llamativo
   de la pantalla.

   Igual que en menu-bar, aquí solo va lo que se PINTA. El tamaño sale del
   layout de NavTabItem (ver StatefulTextButton::sizeHint), así que un
   `padding` en esta regla no tendría efecto sobre las dimensiones. */
QPushButton[class="nav-tab"] {
    background-color: transparent;
    border: none;
    margin: 0px;
}

/* El subrayado NO es el border-bottom del botón: es un QFrame que NavTabItem
   apila al final de su layout. Con el borde de QSS la selección se veía en el
   texto pero la línea no llegaba a dibujarse, porque Qt no aplica de forma
   fiable un borde sobre un QPushButton sin fondo. Un fondo sobre un QFrame sí
   se pinta siempre.

   El frame existe y ocupa sus 2 px en todos los estados, transparente cuando
   no toca: si apareciera solo al seleccionar, el texto de la pestaña brincaría
   2 px en el momento del clic. */
QFrame[class="nav-tab-underline"] {
    background-color: transparent;
    border: none;
}

/* La pestaña activa: negro intenso contra el gris claro del divisor que corre
   por debajo. Ese contraste entre las dos líneas es toda la señal de "aquí
   estás" frente a "aquí hay otra opción". */
QFrame[class="nav-tab-underline"][itemState="selected"] {
    background-color: #111827;
}

/* Misma tipografía y mismos colores que el renglón de la barra lateral
   (QLabel[class="menu-bar-title"]): son dos controles de navegación, así que
   el texto de uno no tiene por qué leerse distinto del otro. El mecanismo de
   itemState también es el mismo, y lo fija la clase base compartida
   StatefulTextButton::refreshState(). */
QLabel[class="nav-tab-title"] {
    background: transparent;
    font-size: 12pt;
    font-weight: 600;
    color: #4B5563;
}

/* La barra lateral usa el azul de marca en hover, pero aquí oscurece: con el
   estado activo marcado en negro, un hover azul insinuaría que seleccionar la
   pestaña la pondría azul. */
QLabel[class="nav-tab-title"][itemState="hover"] {
    color: #111827;
}

QLabel[class="nav-tab-title"][itemState="selected"] {
    color: #111827;
    font-weight: 700;
}


/* ======== BARRA DE FILTROS (Estado, Fecha inicio, Agregar Vehiculo) ======== */
/* Sin borde inferior: la barra de filtros y la lista de tarjetas son la misma
   zona, y la línea de separación entre ellas partía la pantalla en dos por la
   mitad. La única línea horizontal que queda arriba es la de las pestañas. */
#filterBar {
    background-color: transparent;
    border: none;
    padding-bottom: 6px;
}

/* Mismo TRATO tipográfico que los renglones del menú y las pestañas
   (QLabel[class="menu-bar-title"] / [class="nav-tab-title"]): misma familia y
   mismo peso 600, en lugar del peso 500 que tenían y que hacía ver la barra de
   filtros como de otra aplicación.

   El tamaño sí es menor que el de aquellos: a 12pt los controles crecían tanto
   que la barra de filtros pesaba más que las pestañas, y los filtros acompañan
   al inventario, no lo encabezan. El color se queda en el gris apagado por lo
   mismo: son rótulos de un control, no elementos de navegación. */
/* El color va oscuro y no en el gris apagado que tenían antes (#6B7280): a
   13pt ese gris se leía lavado contra el blanco, más como texto deshabilitado
   que como rótulo. */
#filterBar QLabel {
    /* Sin esto, cada rótulo sale con un recuadro BLANCO sobre el gris de la
       página: la regla base QWidget (sección 1) le da fondo blanco a todo, y
       un QLabel que no lo anule lo hereda. Es invisible mientras la página es
       blanca y salta en cuanto deja de serlo. */
    background: transparent;
    font-size: 11pt;
    font-weight: 600;
    color: #374151;
}

/* Botón de acción de contorno (OutlineButton). Aquí solo van el borde y el
   fondo: el tamaño sale del layout del componente, no de un `padding` de esta
   regla (ver StatefulTextButton::sizeHint).

   Sin relleno a propósito. Antes era un bloque gris carbón, el único elemento
   sólido de una pantalla hecha de superficies blancas, y terminaba pesando más
   que el propio inventario. El contorno lo deja igual de legible como acción
   principal sin robarse la atención.

   El radio DEBE ser la mitad de kHeight en outlinebutton.cpp (34/2 = 17). Si
   se pasa de la mitad del alto real, Qt no recorta: deja de redondear y pinta
   un rectángulo. Fue justo lo que ocurrió al bajar el alto del botón sin
   tocar este número. */
QPushButton[class="outline-button"] {
    background-color: transparent;
    border: 1px solid #111827;
    border-radius: 17px;
}

QPushButton[class="outline-button"]:hover {
    background-color: #F2F4F8;
}

QPushButton[class="outline-button"]:pressed {
    background-color: #E9ECF1;
}

QLabel[class="outline-button-title"] {
    background: transparent;
    font-size: 11pt;
    font-weight: 700;
    color: #111827;
}

QLabel[class="outline-button-icon"] {
    background: transparent;
    border: none;
}

/* El ancho es FIJO, no proporcional a la ventana: el layout ya no le da factor
   de estiramiento (ver horizontalLayout_3 en mainwindow.ui), así que este
   min-width es lo único que decide qué tan anchos son los controles, y se ven
   igual en una pantalla grande que en una chica. */
QComboBox[class="filterCombo"] {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 10px;
    padding: 6px 14px;
    font-size: 12px;
    color: #212529;
    min-height: 24px;
    min-width: 200px;
}

QComboBox[class="filterCombo"]:hover {
    border: 1px solid #ADB5BD;
}

QComboBox[class="filterCombo"]:on, QComboBox[class="filterCombo"]:focus {
    border: 2px solid #0A25C9;
}

QComboBox[class="filterCombo"]::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border: none;
    background: transparent;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 12px;
    padding: 4px;
    outline: 0px;
    selection-background-color: transparent;  /*Handled via QListView::item */
}


QComboBox QAbstractItemView::item {
    min-height: 24px;
    padding: 4px 12px;
    border-radius: 8px;
    color: #212529;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #E6E9FC;
    color: #0A25C9;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #E6E9FC;
    color: #0A25C9;
}

/* ---------- QDateEdit (mismo look que QComboBox, sin botón cuadrado) ---------- */
QDateEdit[class="dateFilter"] {
    background-color: #FFFFFF;
    border: 1px solid #E1E4EA;
    border-radius: 8px;
    /* El padding derecho tiene que dar cabida a DOS cosas apiladas contra el
       borde: la flecha del desplegable y, a su izquierda, el icono de
       calendario. Sin él, la fecha se metía debajo de los dos. */
    padding: 6px 56px 6px 14px;
    min-width: 170px;
    font-size: 11pt;
    color: #111827;
}

QDateEdit[class="dateFilter"]:hover {
    border: 1px solid #ADB5BD;
}

QDateEdit[class="dateFilter"]:open, QDateEdit[class="dateFilter"]:focus {
    border: 2px solid #0A25C9;
}

/* Elimina el relieve/recuadro del botón de flecha */
QDateEdit[class="dateFilter"]::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 24px;
    border: none;         /* sin borde propio */
    background: transparent;  /* sin fondo/recuadro que sobresalga */
}

/* Aquí va SOLO la flecha del desplegable, que es la que indica que el control
   se abre. El icono de calendario es aparte: lo pone
   MainWindow::attachCalendarIcon() como QLabel encima del campo, a la
   izquierda de esta flecha.

   El calendario no se pinta como `image` de este subcontrol porque así no
   llegaba a dibujarse en la aplicación, aunque la misma regla sí pinta en un
   banco de pruebas aislado tanto a escala 1 como a escala 2. La flecha, en
   cambio, se dibuja sin problema: la diferencia entre las dos reglas era que
   esta lleva width/height explícitos. */
QDateEdit[class="dateFilter"]::down-arrow {
    width: 12px;
    height: 12px;
    image: url(:/icons/chevron_down.png);
}

/* La caja del icono no pinta fondo propio: la regla base de QWidget (sección
   1) le pondría blanco y taparía el borde redondeado del campo. */
QLabel#dateFilterIcon {
    background: transparent;
    border: none;
}


/* Quita el botón nativo de subir/bajar (spin buttons) que Qt agrega por defecto */
QDateEdit[class="dateFilter"]::up-button,
QDateEdit[class="dateFilter"]::down-button {
    width: 0px;
    border: none;
    background: transparent;
}

/* Popup del calendario */
QCalendarWidget QWidget {
    background-color: #ffffff;
    color: #2c3856;
}

QCalendarWidget QAbstractItemView:enabled {
    selection-background-color: #081ca2;
    selection-color: #ffffff;
    outline: none;
}

QCalendarWidget QAbstractItemView::item:selected {
    background-color: #081ca2;
    color: #ffffff;
    border-radius: 6px;
}

/* 10. SCROLLBARS (globales)
   ---------------------------------------------------------------------------
   Tampoco llevan filtro: aplican a las dos áreas desplazables del asistente
   (checklist de condición y galería de fotos), a los popups de los combos y al
   login, no solo a la lista del inventario. */
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    /* US-03.1 estilizó handle y flechas pero no el canal; sin esto, en algunos
       temas de Windows se alcanza a ver el surco nativo detrás. */
    background: transparent;
}
/* ---------- QListWidget contenedor de las tarjetas ---------- */
QListWidget#vehicleList {
    background-color: transparent;
    border: none;
    outline: none;
}

/* Mensaje de "no hay vehículos" / error de lectura, que MainWindow inserta
   como renglón de la lista. Transparente por el mismo motivo que los rótulos
   de los filtros: si no, hereda el blanco de la regla base de QWidget y se ve
   como una banda blanca sobre el gris de la página. */
QLabel#inventoryMessage {
    background: transparent;
    font-size: 11pt;
    color: #6B7280;
}

/* El renglón es solo el hueco donde vive la tarjeta: no debe pintar nada
   propio. Sin esto, el resaltado de selección de Qt se dibuja DEBAJO de la
   tarjeta y asoma en las cuatro esquinas, justo donde el borde redondeado
   deja ver el fondo del renglón. */
QListWidget#vehicleList::item {
    background: transparent;
    border: none;
}

QListWidget#vehicleList::item:selected,
QListWidget#vehicleList::item:hover {
    background: transparent;
}

/* Scrollbar del QListWidget */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #a9b3c7;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #a9b3c7;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}
