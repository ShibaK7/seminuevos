       <string>side-bar</string>
      </property>
      <!-- Sin atributo `stretch`: los cuatro renglones del menú los inserta
           MainWindow::buildSidebarMenu() en tiempo de ejecución, y los factores
           de estiramiento del .ui se fijan por ÍNDICE durante setupUi(). Al
           insertar widgets después, los índices se corren y el estiramiento
           acabaría aplicado al renglón equivocado: el primer módulo se
           comería el espacio libre en vez del espaciador. El espaciador final
           es Expanding, así que empuja el menú hacia arriba por sí solo. -->
      <layout class="QVBoxLayout" name="verticalLayout_2">
       <property name="spacing">
        <number>12</number>
       </property>
       <property name="sizeConstraint">
        <enum>QLayout::SizeConstraint::SetDefaultConstraint</enum>
       </property>
       <property name="leftMargin">
        <number>0</number>
       </property>
       <property name="topMargin">
        <number>12</number>
       </property>
       <property name="rightMargin">
        <number>0</number>
       </property>
       <property name="bottomMargin">
        <number>12</number>
       </property>
       <item>
        <widget class="AspectRatioImageLabel" name="logoLabel">
         <property name="sizePolicy">
          <sizepolicy hsizetype="Ignored" vsizetype="Fixed">
           <horstretch>0</horstretch>
           <verstretch>0</verstretch>
          </sizepolicy>
         </property>
         <!-- Altura fija de 60 px, antes 90. El logo es de 625x263 (2.376:1) y
              con scaledContents se estiraba para llenar la caja completa: a lo
              ancho de la barra daba casi 2:1, o sea aplastado a lo alto.
              AspectRatioImageLabel respeta la proporción, así que a 60 px de
              alto el pixmap sale de 142 px de ancho y queda centrado, con el
              aire lateral saliendo solo de la diferencia contra el ancho de la
              barra. El pixmap NO se declara aquí: lo carga MainWindow con
              setSourcePixmap(), porque la propiedad `pixmap` del Designer
              llamaría a QLabel::setPixmap y dejaría vacío el original que el
              componente necesita para reescalar. -->
         <property name="minimumSize">
          <size>
           <width>0</width>
           <height>60</height>
          </size>
         </property>
         <property name="maximumSize">
          <size>
           <width>16777215</width>
           <height>60</height>
          </size>
         </property>
         <property name="text">
          <string/>
         </property>
         <property name="alignment">
          <set>Qt::AlignmentFlag::AlignCenter</set>
         </property>
        </widget>
       </item>
       <item>
        <spacer name="verticalSpacer">
         <property name="orientation">
          <enum>Qt::Orientation::Vertical</enum>
         </property>
         <property name="sizeType">
          <enum>QSizePolicy::Policy::Expanding</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>390</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
    </item>
