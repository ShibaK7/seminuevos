        <widget class="QFrame" name="topBarFrame">
         <property name="frameShape">
          <enum>QFrame::Shape::StyledPanel</enum>
         </property>
         <property name="frameShadow">
          <enum>QFrame::Shadow::Raised</enum>
         </property>
         <property name="class" stdset="0">
          <string>top-bar</string>
         </property>
         <layout class="QHBoxLayout" name="horizontalLayout_4" stretch="0,0,0">
          <!-- spacing 10, antes 6: separa el avatar del rol. Con 6 el texto
               quedaba pegado al círculo. -->
          <property name="spacing">
           <number>10</number>
          </property>
          <property name="sizeConstraint">
           <enum>QLayout::SizeConstraint::SetDefaultConstraint</enum>
          </property>
          <property name="topMargin">
           <number>12</number>
          </property>
          <!-- 32 px, antes 12: es el mismo margen derecho que usan la barra de
               filtros y las tarjetas, para que "Administrador" termine en la
               misma vertical que el botón "Agregar Vehículo" y el borde de las
               tarjetas en lugar de sobresalir 20 px. -->
          <property name="rightMargin">
           <number>32</number>
          </property>
          <item>
           <spacer name="horizontalSpacer_5">
            <property name="orientation">
             <enum>Qt::Orientation::Horizontal</enum>
            </property>
            <property name="sizeHint" stdset="0">
             <size>
              <width>638</width>
              <height>20</height>
             </size>
            </property>
           </spacer>
          </item>
          <item>
           <!-- Antes era un QFrame con `background-color: rgb(0,170,255)`
                escrito a mano: un marcador de posición, el cuadro azul.

                El círculo viene dibujado en el PNG y no de un border-radius de
                QSS, para que no dependa de que la hoja de estilos se aplique
                (en esta aplicación ya ha fallado en varios sitios) ni de que
                el alto del widget coincida con el doble del radio, que es lo
                que dejó cuadrado el botón de agregar vehículo. Se genera con
                scratchpad/makeavatar.cpp, con su variante @2x. -->
           <widget class="QLabel" name="avatarLabel">
            <property name="minimumSize">
             <size>
              <width>32</width>
              <height>32</height>
             </size>
            </property>
            <property name="maximumSize">
             <size>
              <width>32</width>
              <height>32</height>
             </size>
            </property>
            <property name="text">
             <string/>
            </property>
            <property name="pixmap">
             <pixmap resource="../resources/Resources.qrc">:/icons/avatar.png</pixmap>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QLabel" name="userRoleLabel">
            <property name="text">
             <string>Administrador</string>
            </property>
           </widget>
          </item>
