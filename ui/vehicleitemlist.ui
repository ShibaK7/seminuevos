  <property name="styleSheet">
   <string notr="true">/* ---------- Tarjeta del vehículo (el QWidget dentro de la lista) ---------- */

QWidget#VehicleItemList {
	min-height: 200px;
    max-height: 200px;
}

QWidget#VehicleItemList * {
	background-color: #c3cbdb;
	border-top-right-radius: 10px;
	border-top-left-radius: 10px;
	border-bottom-right-radius: 10px;
	border-bottom-left-radius: 10px;
}

QFrame[class=&quot;lineSpecial&quot;] {
    border-left: 2px solid #6c757d;
    min-height: 25px;
    max-height: 25px;
}

/* Modelo del auto */
QLabel#vehicleTitle {
    color: #46527a;
    font-size: 26px;
    font-weight: 700;
}

/* Línea de specs: 2016 | Negro | 190,000 | Automático | Motor */
QLabel[class=&quot;detailLine&quot;] {
    color: #46527a;
    font-size: 14px;
}

/* &quot;Agregado el: ...&quot; */
QLabel[class=&quot;dateIncomingLabel&quot;] {
    color: #46527a;
    font-size: 12px;
}

/* Precio */
QLabel#priceLabel {
    color: #46527a;
    font-size: 26px;
    font-weight: 800;
}

/* Badge verde &quot;Disponible&quot; */
QLabel#statusBadge {
    border-radius: 10px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 700;
    color: #ffffff;
}

QLabel#statusBadge[status=&quot;available&quot;] {
    background-color: #2fae4e;
}

QLabel#statusBadge[status=&quot;reserved&quot;] {
    background-color: #e0a52c;
}

QLabel#statusBadge[status=&quot;sold&quot;] {
    background-color: #c94444;
}

/* Primary Brand Action Button */
QPushButton#detailsButton {
    background-color: #0A25C9;   /* DE LA HOZ Royal Blue */
    border: none;
    color: #FFFFFF;
    font-size: 12pt;
    font-weight: 600;
    border-radius: 6px;
    padding: 8px 18px;
}

QPushButton#detailsButton:hover {
    background-color: #081CA2;
}

QPushButton#detailsButton:pressed {
    background-color: #06157B;
}</string>
