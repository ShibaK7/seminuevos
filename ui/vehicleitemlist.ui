   <!-- 24 px a cada lado para alinear el borde de la tarjeta con las pestañas
        y con la barra de filtros: la columna del inventario ya no aporta esa
        sangría (la cedió para que el divisor llegue de orilla a orilla), así
        que cada zona la pone por su cuenta. Arriba y abajo se quedan en el
        valor por omisión, que es lo que separa una tarjeta de la siguiente. -->
   <property name="leftMargin">
    <number>24</number>
   </property>
   <property name="rightMargin">
    <number>32</number>
   </property>
