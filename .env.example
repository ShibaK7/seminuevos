# Copia este archivo a .env y ajústalo si hace falta para desarrollo local.
POSTGRES_USER=seminuevos_app
POSTGRES_PASSWORD=changeme
POSTGRES_DB=seminuevos
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Usuarios de prueba, SOLO para desarrollo. Con true, cada arranque crea los
# que falten: a/a, admin/Admin123! y vendedor/Vendedor123! (a/a existe para
# entrar rápido mientras se programa). Fuera de una máquina de desarrollo
# déjalo en false: son contraseñas que conoce todo el equipo.
SEED_TEST_USERS=true

# Carpeta donde se guardan fotos/documentos de vehículos (storage/vehicles/{vin}/...).
# Si se deja vacío, se usa <raíz del repo>/storage.
STORAGE_ROOT=

# Navegación libre en el asistente de registro de vehículos: con true (o 1) se
# puede ir a cualquier paso sin validar los anteriores. Sirve para desarrollar
# estilos navegando entre pasos sin capturar datos. NUNCA en producción.
#
# Existe para no volver a comentar la validación en el código: así se perdió
# en 1d9c156, y el asistente dejó pasar pasos incompletos sin que nadie lo
# notara. Guardar sigue validando todo aunque esté encendida.
WIZARD_FREE_NAVIGATION=false
